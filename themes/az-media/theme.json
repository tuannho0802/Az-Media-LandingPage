{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "1200px", "wideSize": "1320px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "#0A2A66" },
        { "slug": "primary-dark", "name": "Primary dark", "color": "#06173D" },
        { "slug": "accent", "name": "Accent (nền, icon, trang trí)", "color": "#2F6BFF" },
        { "slug": "accent-text", "name": "Accent text (chữ, đạt AA)", "color": "#1D4ED8" },
        { "slug": "tint", "name": "Tint", "color": "#E8EEFB" },
        { "slug": "text", "name": "Text", "color": "#0F172A" },
        { "slug": "muted", "name": "Muted", "color": "#475569" },
        { "slug": "border", "name": "Border", "color": "#E2E8F0" },
        { "slug": "background", "name": "Background", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "jakarta",
          "name": "Plus Jakarta Sans",
          "fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
          "fontFace": [
            { "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap",
              "src": ["file:./assets/fonts/plus-jakarta-sans-vietnamese-wght-normal.woff2"],
              "unicodeRange": "U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB" },
            { "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap",
              "src": ["file:./assets/fonts/plus-jakarta-sans-latin-ext-wght-normal.woff2"],
              "unicodeRange": "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF" },
            { "fontFamily": "Plus Jakarta Sans", "fontStyle": "normal", "fontWeight": "200 800", "fontDisplay": "swap",
              "src": ["file:./assets/fonts/plus-jakarta-sans-latin-wght-normal.woff2"],
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD" }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "1.0625rem" },
        { "slug": "medium", "name": "Medium", "size": "1.25rem" },
        { "slug": "large", "name": "Large", "size": "clamp(1.5rem, 1.2rem + 1vw, 2rem)" },
        { "slug": "xl", "name": "XL", "size": "clamp(2rem, 1.4rem + 2vw, 3rem)" }
      ]
    },
    "spacing": { "units": ["px", "rem", "em", "%", "vw"] },
    "custom": { "radius": { "sm": "8px", "md": "12px", "lg": "20px" } }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--background)", "text": "var(--wp--preset--color--text)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--jakarta)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.7" },
    "spacing": { "padding": { "left": "1.25rem", "right": "1.25rem" }, "blockGap": "1.25rem" },
    "elements": {
      "heading": { "color": { "text": "var(--wp--preset--color--primary)" }, "typography": { "fontWeight": "700", "lineHeight": "1.15" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent-text)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "#FFFFFF" },
        "typography": { "fontWeight": "600", "fontSize": "1rem", "lineHeight": "1.2" },
        "border": { "radius": "8px" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.6rem", "right": "1.6rem" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--primary-dark)", "text": "#FFFFFF" } }
      }
    }
  },
  "templateParts": [
    { "name": "announcement-bar", "title": "Announcement bar", "area": "uncategorized" },
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
